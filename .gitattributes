# 统一换行符策略，避免 Windows 编辑后推到 Linux 服务器出现 CRLF 问题
# （典型表现：shell 脚本报 `syntax error near unexpected token`）

* text=auto

# Shell 脚本必须使用 LF，否则 Linux 上无法执行
*.sh text eol=lf

# Docker / Nginx / YAML 配置统一 LF，保持容器内行为一致
Dockerfile text eol=lf
*.dockerignore text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf

# Windows 批处理必须保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制资源不参与换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.woff binary
*.woff2 binary
