FROM node:18-slim

WORKDIR /app
ENV TZ=Asia/Shanghai

RUN apt-get update && \
    apt-get install -y --no-install-recommends tzdata && \
    ln -snf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone && \
    groupadd -r spider && useradd -r -g spider -d /app -s /sbin/nologin spider && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ── npm 依赖安装 ──
# 依赖清单先于业务代码 COPY，使代码变更时可以命中依赖层缓存；
# buildkit_enabled 时额外挂载 npm 缓存目录，跨构建复用已下载的包。
COPY package*.json /app/
RUN {% if buildkit_enabled %}--mount=type=cache,target=/root/.npm {% endif %}npm install

# ── 业务代码 ──
COPY . /app/
RUN find . -maxdepth 2 -not -path '*/.*' && \
    chown -R spider:spider /app

USER spider
CMD {{ entrypoint }}
